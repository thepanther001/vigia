# Copia este archivo como .env y llena las llaves (el .env NO se sube a GitHub).
#   cp .env.example .env

# Llave gratuita de la NVD: https://nvd.nist.gov/developers/request-an-api-key
# Sin llave funciona, pero ~10 veces más lento.
NVD_API_KEY=

# Token de GitHub (solo lectura pública, sin permisos especiales).
# En GitHub Codespaces NO hace falta: la variable GITHUB_TOKEN ya existe.
# Fuera de Codespaces: https://github.com/settings/tokens  (fine-grained, sin permisos)
GITHUB_TOKEN=

# Webhook de Discord para alertas (opcional):
# Canal → Editar canal → Integraciones → Webhooks → Nuevo webhook → Copiar URL
DISCORD_WEBHOOK_URL=
